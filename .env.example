# ---------------------------------------------------------------- server
NODE_ENV=development
PORT=4000
# Comma separated. 5173/5174 = dev servers, 4173/4174 = vite preview.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173,http://localhost:4174

# ---------------------------------------------------------------- supabase
# Supabase dashboard -> Project Settings -> API Keys
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The publishable key (sb_publishable_...). Safe in a browser.
# On older projects this is the legacy "anon" JWT instead.
SUPABASE_ANON_KEY=

# The secret key (sb_secret_...). Server only — it bypasses row-level
# security, so it must never reach a browser.
# On older projects this is the legacy "service_role" JWT instead.
SUPABASE_SERVICE_ROLE_KEY=

# ONLY for projects still signing tokens with the legacy HS256 shared secret
# (Project Settings -> JWT Keys -> JWT Secret).
#
# Leave this BLANK on projects using asymmetric signing keys (ES256/RS256) —
# the API then verifies access tokens against the project's JWKS endpoint,
# which is the current default. Check which you have:
#   curl https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json
# Keys returned -> leave blank. Empty key list -> set the HS256 secret here.
SUPABASE_JWT_SECRET=

SUPABASE_STORAGE_BUCKET=menu

# ---------------------------------------------------------------- database
# Project Settings -> Database -> Connection string.
# DATABASE_URL is the pooled connection (port 6543) used at runtime.
# DIRECT_URL is the direct/session connection (port 5432) migrations need.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------- ordering
# Naira.
DELIVERY_FEE=1500
SERVICE_FEE_PERCENT=0
MIN_ORDER_TOTAL=0

# ---------------------------------------------------------------- paystack
# Dashboard -> Settings -> API Keys & Webhooks.
# Test keys (sk_test_/pk_test_) charge nothing; live keys (sk_live_/pk_live_)
# take real money. The secret key must never reach a browser.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where Paystack sends the customer back to after payment. Must be a page the
# storefront serves; it reads ?reference= and calls the verify endpoint.
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/callback

# Methods offered on the payment page, comma separated, in display order.
# Remove one to switch it off: card,bank_transfer,ussd,bank,qr,mobile_money,eft
PAYSTACK_CHANNELS=card,bank_transfer,ussd,bank,qr,mobile_money,eft

# ---------------------------------------------------------------- web push
# Generate a pair with `npm run push-keys`. The public key also goes into the
# storefront as VITE_VAPID_PUBLIC_KEY; the private key is server only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:orders@sbjfoods.com

# ---------------------------------------------------------------- storage
# Public bucket holding feed images. Create it once in the Supabase dashboard
# (Storage -> New bucket -> public) or it will 404 on the first upload.
SUPABASE_FEED_BUCKET=feed

# ---------------------------------------------------------------- railway
#
# What changes when this runs on Railway rather than a laptop:
#
#   NODE_ENV               production
#   PORT                   set by Railway — do not define it yourself
#   CORS_ORIGINS           the deployed storefront and kitchen origins, with
#                          no trailing slash, e.g.
#                          https://sbjfoods.netlify.app,https://sbj-kitchen.netlify.app
#   PAYSTACK_CALLBACK_URL  https://<storefront>/payment/callback
#   DATABASE_URL           the pooled Supabase URL (6543, ?pgbouncer=true)
#   DIRECT_URL             the direct Supabase URL (5432) — migrations need it
#
# Everything else carries over unchanged. Paste them into the service's
# Variables tab; Railway injects them at build and at run.
